{
  "name": "@sfysh/compiler",
  "version": "0.0.0",
  "description": "Starfysh compiler: deterministic templated codegen that turns a validated IR workflow into a Starfysh TypeScript script.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sfysh/ir": "workspace:*",
    "handlebars": "^4.7.8",
    "prettier": "^3.4.0"
  }
}
