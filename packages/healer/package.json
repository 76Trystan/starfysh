{
  "name": "@sfysh/healer",
  "version": "0.0.0",
  "private": true,
  "description": "Healer for Starfysh. Takes a workflow step that triage classified as a site change, asks a model for a patch to that one step, and accepts the patch only after it validates and verifies.",
  "keywords": [
    "starfysh",
    "healer",
    "healing",
    "self-healing",
    "browser-automation"
  ],
  "homepage": "https://github.com/76Trystan/starfysh#readme",
  "bugs": {
    "url": "https://github.com/76Trystan/starfysh/issues"
  },
  "license": "Apache-2.0",
  "author": "Trystan Frederick",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/76Trystan/starfysh.git",
    "directory": "packages/healer"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sfysh/ir": "workspace:*",
    "@sfysh/providers": "workspace:*",
    "@sfysh/runtime": "workspace:*",
    "@sfysh/triage": "workspace:*",
    "@sfysh/verifier": "workspace:*"
  }
}
