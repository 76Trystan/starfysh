{
  "name": "@sfysh/parser",
  "version": "0.0.0",
  "private": true,
  "description": "Parser that lifts hand-written Playwright TypeScript scripts into the Starfysh IR, so existing scripts can be verified and healed by the Starfysh toolchain.",
  "keywords": [
    "starfysh",
    "playwright",
    "parser",
    "ir",
    "browser-automation"
  ],
  "homepage": "https://github.com/76Trystan/starfysh#readme",
  "bugs": {
    "url": "https://github.com/76Trystan/starfysh/issues"
  },
  "license": "Apache-2.0",
  "author": "Trystan Frederick",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/76Trystan/starfysh.git",
    "directory": "packages/parser"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sfysh/ir": "workspace:*"
  }
}
