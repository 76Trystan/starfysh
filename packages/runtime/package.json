{
  "name": "@sfysh/runtime",
  "version": "0.1.0",
  "description": "Starfysh runtime: workflow runner, vault, assertions, and emit helpers used by compiled Starfysh scripts.",
  "keywords": [
    "starfysh",
    "runtime",
    "workflow",
    "browser-automation",
    "scheduler",
    "page-automation"
  ],
  "homepage": "https://github.com/76Trystan/starfysh#readme",
  "bugs": {
    "url": "https://github.com/76Trystan/starfysh/issues"
  },
  "license": "Apache-2.0",
  "author": "Trystan Frederick",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/76Trystan/starfysh.git",
    "directory": "packages/runtime"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sfysh/ir": "workspace:*",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0"
  }
}
