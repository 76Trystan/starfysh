{
  "name": "@sfysh/triage",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic triage classifier for Starfysh. Pure function that maps a failed workflow run to a FailureKind (flake, auth, site, unknown) with a short reason, so the healer and hosted scheduler can route failures without invoking a model.",
  "keywords": [
    "starfysh",
    "triage",
    "classifier",
    "healing",
    "browser-automation"
  ],
  "homepage": "https://github.com/76Trystan/starfysh#readme",
  "bugs": {
    "url": "https://github.com/76Trystan/starfysh/issues"
  },
  "license": "Apache-2.0",
  "author": "Trystan Frederick",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/76Trystan/starfysh.git",
    "directory": "packages/triage"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sfysh/ir": "workspace:*",
    "@sfysh/runtime": "workspace:*"
  }
}
