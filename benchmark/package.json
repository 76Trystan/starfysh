{
  "name": "@sfysh/benchmark",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "node --import tsx/esm harness/index.ts",
    "typecheck": "tsc --noEmit",
    "test:drift": "vitest run --config drift/vitest.config.ts",
    "heal:drift": "node --env-file-if-exists=../.env --import tsx/esm drift/run.ts",
    "report:drift": "node --import tsx/esm drift/report-cli.ts"
  },
  "dependencies": {
    "@sfysh/healer": "workspace:*",
    "@sfysh/ir": "workspace:*",
    "@sfysh/playwright-adapter": "workspace:*",
    "@sfysh/providers": "workspace:*",
    "@sfysh/runtime": "workspace:*",
    "@sfysh/triage": "workspace:*",
    "@sfysh/verifier": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright-core": "^1.49.0",
    "tsx": "^4.19.0"
  }
}
